# Единые настройки редактора. VS Code читает файл через расширение "EditorConfig for VS Code".
# Концы строк здесь не заданы: ими управляет .gitattributes.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
tab_width = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
# Два пробела в конце строки в Markdown означают перенос.
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

[gradlew]
end_of_line = lf
